mapscripts DianciesCave_DreamSection_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_0, 0 {
            turnobject(LOCALID_PLAYER, DIR_NORTH)
        }
    ]
}

script DianciesCave_DreamSection_EventScript_BusyCarbink
{
    lockall
    msgbox(format("The Carbink is quite hard at work.\nBest not to disturb it!"))
    closemessage
    release
    end
}

movement DiancieMovements
{
    emote_exclamation_mark,
    delay_16 * 2,
    jump_in_place_left,
    jump_in_place_up,
    jump_in_place_right,
    jump_in_place_down,
}

script DianciesCave_DreamSection_EventScript_Diancie
{
    lockall
    applymovement(LOCALID_DREAMSECTION_DIANCIE, DiancieMovements)
    waitmovement(LOCALID_DREAMSECTION_DIANCIE)
    setspeaker(SP_NAME_DIANCIE)
    msgbox("I cannot believe my eyes!\nTo meet you at last…!")
    msgbox("Words fail me from how overjoyed I am\nmeeting you…")
    msgbox("That said, we don't have much time.\n"
            "I have an important message to depart.")
    msgbox("A rot has seeded itself in our home.")
    msgbox("It has festered, growing like a weed. It\nthreatens to strangle our very Heart.")
    closemessage
    releaseall
}