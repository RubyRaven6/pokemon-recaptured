const ATTENDANT = LOCALID_DEWFORD_HARBOR_ATTENDANT

mapscripts DewfordTown_Harbor_MapScripts{}

script DewfordTown_Harbor_EventScript_Teller
{
	lockall
	cueobjecttalking(ATTENDANT)
	setspeaker(SP_NAME_ATTENDANT)	
	msgbox("Good day! May I see your ticket?")
	waitmovement(0)
	checkitem(ITEM_TRAINER_TICKET)
	if(var(VAR_RESULT))
	{
		goto(AttendantAsksWhereYoureGoing)
	}
	else
	{
		setspeaker(SP_NAME_NONE)
		msgbox("You think to yourself… You probably\nshouldn't leave Elsie right away.")
		setspeaker(SP_NAME_ATTENDANT)
		msgbox("Uhm… okay then.\nHave a nice day!")
		closemessage
	}

AttendantAsksWhereYoureGoing:
	releaseall
	end
}