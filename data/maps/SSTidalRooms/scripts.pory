mapscripts SSTidalRooms_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		switch(var(VAR_INTRO_SEQUENCE_STATE))
		{
			case 0:
			case 1:
				setflag(FLAG_SYS_QUEST_MENU_GET)
				setflag(FLAG_HIDE_ELSIE_IN_SS_TIDAL_CABIN)
			default:
				setobjectxyperm(LOCALID_SS_TIDAL_ELSIE, 3, 11)
		}
	}

	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_INTRO_SEQUENCE_STATE, 0: SSTidalRooms_EventScript_WokeUpLikeThis
		VAR_INTRO_SEQUENCE_STATE, 1: SSTidalRooms_EventScript_ElsieEnters
		VAR_INTRO_SEQUENCE_STATE, 4: SSTidalRooms_EventScript_PA_Announcement
		VAR_INTRO_SEQUENCE_STATE, 5: SSTidalRooms_EventScript_DisembarkElvieConvo
	]
}

script(local) SSTidalRooms_EventScript_WokeUpLikeThis
{
	questmenu(QUEST_MENU_SET_ACTIVE, QUEST_FIND_THE_HEART)
	msgbox("A strange dream… that felt real all the\nsame.")
	msgbox("You take out your PDA, and take some\nnotes.")
	closemessage
	openquestmenu
	setvar(VAR_INTRO_SEQUENCE_STATE, 1)
}

script(local) SSTidalRooms_EventScript_ElsieEnters
{
	addobject(LOCALID_SS_TIDAL_ELSIE)
	clearflag(FLAG_HIDE_ELSIE_IN_SS_TIDAL_CABIN)
	playse(SE_DOOR)
	applymovement(LOCALID_SS_TIDAL_ELSIE, moves(walk_in_place_fast_up, delay_16 * 2))
	waitmovement(0)
	waitse
	applymovement(LOCALID_SS_TIDAL_ELSIE, moves(walk_up * 5, face_right))
	applymovement(LOCALID_PLAYER, moves(delay_16 * 5, face_left))
	waitmovement(LOCALID_SS_TIDAL_ELSIE)
	waitmovement(LOCALID_PLAYER)
	setspeaker(SP_NAME_ELSIE)
	message(
		"Hey there, Champ! You're finally awake.\nWe're almost at Dewford.\p"
		"I didn't think we'd be this close to our\nnew life.\p"
		"I'm… sorry that I couldn't help you out\nsooner.\pBut I'll do my best to make it up to you\nas your big sis.\p"
		"We can be sappy once we have our new\ndigs, though. We still have some time\lbefore we dock.\p"
		"Why not go stretch your legs?\p"
		"Just make sure to come back once we're\nabout to disembark, alright, Champ?"
	)
	waitmessage
	waitbuttonpress
	closemessage
	applymovement(LOCALID_SS_TIDAL_ELSIE, moves(walk_left, face_down, delay_16 * 2))
	waitmovement(0)
	setvar(VAR_INTRO_SEQUENCE_STATE, 2)
}

script(local)SSTidalRooms_EventScript_PA_Announcement
{
	setvar(VAR_INTRO_SEQUENCE_STATE, 5)
	setspeaker("P.A.")
	playse(SE_DING_DONG)
	msgbox(
		"Good afternoon, passengers. We are\nabout to dock in Dewford.\lPlease ready to disembark.\p"
		"Thank you for patronizing the SS Tidal.\nWe hope to see you again!"
	)
	waitse
	closemessage
	warp(MAP_SS_TIDAL_CORRIDOR, 4, 10)
	waitstate
}

script(local)SSTidalRooms_EventScript_DisembarkElvieConvo
{
	applymovement(LOCALID_PLAYER, moves(walk_up * 5, face_left))
	applymovement(LOCALID_SS_TIDAL_ELSIE, moves(delay_16 * 5, face_right))
	waitmovement(LOCALID_PLAYER)
	waitmovement(LOCALID_SS_TIDAL_ELSIE)
	setspeaker(SP_NAME_ELSIE)
	msgbox("You got here quick, huh. Excited to\nsee our new home?")
	closemessage
	mcdialogue("Yeah!", "I'm nervous…", "As long as I'm with you.")
	cueobject(LOCALID_SS_TIDAL_ELSIE, DIR_EAST)
	setspeaker(SP_NAME_ELSIE)
	switch(var(VAR_RESULT))
	{
		case 0:
			msgbox("Nice to see you in good spirits!")
		case 1:
			msgbox("Don't be. We're together now, alright?")
		case 2:
			msgbox("…{PAUSE 90} …{PAUSE 90} …{PAUSE 90}\nSame goes for me with you, Champ.")
	}
	msgbox("Well, nothing left to it but to do it!\nLet's go.")
	closemessage
	setvar(VAR_INTRO_SEQUENCE_STATE, 6)
	warp(MAP_DEWFORD_TOWN, 27, 15)
	waitstate
}

script SSTidalRooms_EventScript_Elsie
{
	faceplayer
	setspeaker(SP_NAME_ELSIE)
	msgbox("Just packing the rest of my stuff.\nWhat's up?")
	mcdialogueB("How are you?", "What's Diancie?")
	switch(var(VAR_RESULT))
	{
		case 0:
			setspeaker(SP_NAME_ELSIE)
			message(
				"As good as I could be, I guess! A little\nseasick though.\p"
				"I'm a big girl, though. So no need to\nworry about me."
				)
			waitmessage
			waitbuttonpress
			closemessage
			end
		case 1:
			setspeaker(SP_NAME_ELSIE)
			message(
				"Diancie? Oh, you mean from the myths?\nI guess you didn't get told those\lstories when you were younger.\p"
				"Well, she's an important Pok\emon; one of\nthe Guardians that watch over us.\p"
				"It's said that she guards the Heart,\nthe manifestation of all our thoughts,\lfeelings, and inner hearts."
				)
			waitmessage
			waitbuttonpress
			closemessage
			end
		default:
			setspeaker(SP_NAME_ELSIE)
			msgbox("Just let me know if you need anything,\nChamp.")
			closemessage
			end
	}
}

script SSTidalRooms_EventScript_Bed{
	lockall
	msgbox("It was a comfy bed.\nBetter stretch your legs now, though.", MSGBOX_DEFAULT)
	closemessage
	releaseall
	end
}

script SSTidalRooms_EventScript_Mom
{
	lockall
	faceplayer
	setspeaker("Tired Mom")
	message(
		"Thank you for being understanding of\nBilly.\p"
		"Many people can't really handle her\nenergy. I worry she rubs people the\lwrong way."
		)
	waitmessage
	waitbuttonpress
	closemessage
	mcdialogueB("Where to next?", "Do you know Diancie?")
	switch(var(VAR_RESULT))
	{
		case 0:
			setspeaker("Tired Mom")
			message(
				"Our next stop would be Rustboro, the\none right after this one."
				"We went to visit Billy's mom over in Ever\nGrande City.\pShe's works as a Pok\emon League Coach\nto the advanced trainers."
				)
			waitmessage
			waitbuttonpress
			closemessage
		case 1:
			setspeaker("Tired Mom")
			message(
				"Well, you seem a little too old for fairy\ntales like that, hm?\p"
				"I suppose there's no age to stop being\nwhimsical.\p"
				"Tell you what, though, I did once wish\nupon a star for Diancie to bless me…\p"
				"And wouldn't you know it, I met the one\nwoman who'd be my wife the next day!"
				)
			waitmessage
			waitbuttonpress
			closemessage
		default:
			setspeaker("Tired Mom")
			msgbox("I hope you have a safe rest of your\njourney!")
			closemessage
	}
	releaseall
	end
}

script SSTidalRooms_EventScript_Billy
{
	setspeaker("Billy")
	msgbox("WEEEEEEE!", MSGBOX_NPC)
	end
}

script SSTidalRooms_EventScript_Nerd
{
	lockall
	setspeaker("Phone")
	message(
		"Team Armistice has once again released\na public statement condemning the\lPok\emon League.\p"
		"The party has drawn out significant\ndiscourse lobbying to disband the\lLeague as a whole, among other things."
		)
	waitmessage
	waitbuttonpress
	closemessage
	setspeaker("Troubled Guy")
	message("Tch. People just don't understand them\nat all…\p")
	waitmessage
	faceplayer
	setspeaker("Troubled Guy")
	message("Huh? What do you want, kid?")
	waitmessage
	waitbuttonpress
	mcdialogueB("What is that?", "Do you know Diancie?")
	switch(var(VAR_RESULT))
	{
		case 0:
			setspeaker("Troubled Guy")
			message(
				"It's just the news. I'm following Team\nArmistice and what the sheeple are\lbranding them.\p"
				"They took the only thing Team Plasma\nwas right about.\p"
				"People just don't get they want what's\ngood for people, y'know?"
				)
			waitmessage
			waitbuttonpress
			closemessage
		case 1:
			setspeaker("Troubled Guy")
			message(
				"Figures a kid like you would still even\nbelieve in made up Pok\emon like that.\p"
				"If you're done bothering me with myths,\nyou can go scram."
				)
			waitmessage
			waitbuttonpress
			closemessage
		default:
			setspeaker("Troubled Guy")
			msgbox("Get outta my room.")
			closemessage
	}
	applymovement(LOCALID_SS_TIDAL_TROUBLED_NERD, moves(face_up))
	waitmovement(0)
	releaseall
	end
}

script SSTidalRooms_EventScript_Gentleman
{
	lockall
	setspeaker("Gentleman")
	message(
		"Sigh… Another trainer attacked on the\nwild areas? Those dastardly Corvids…\p"
		)
	waitmessage
	faceplayer
	message(
		"Oh, hello there. Is there anything I\ncould help you with, child?"
		)
	waitmessage
	waitbuttonpress
	closemessage
	mcdialogueB("What were you reading?", "Do you know Diancie?")
	switch(var(VAR_RESULT))
	{
		case 0:
			setspeaker("Gentleman")
			message(
				"I was just reading my newspaper, is all.\nTrainers all'round are being assaulted.\p"
				"The police so far have said that the\nCorvid gang are likely behind it.\p"
				"I've lived long enough to know that may\nbe the most they're able to figure out,\lconsidering what passes a cop."
				)
			waitmessage
			waitbuttonpress
			closemessage
		case 1:
			setvar(VAR_INTRO_SEQUENCE_STATE, 4)
			setvar(VAR_TEMP_0, 2)
			setspeaker("Gentleman")
			message(
				"Ahh… that takes me back. Back then,\npeople were trying to search for her\lin Rusturf Tunnel. But, to no avail.\p"
				"After all, we'd found a whole colony of\nCarbink!\p"
				"I don't believe she was ever found,\nbut some still think she's there."
				)
			waitmessage
			waitbuttonpress
			closemessage
			updatequest(QUEST_FIND_THE_HEART)
		default:
			setspeaker("Gentleman")
			msgbox("Take care!")
			closemessage
	}
	releaseall
	end
}

raw `

SSTidalRooms_EventScript_SnatchGiver::
	lock
	faceplayer
	goto_if_set FLAG_RECEIVED_TM_SNATCH, SSTidalRooms_EventScript_ExplainSnatch
	msgbox SSTidalRooms_Text_NotSuspiciousTakeThis, MSGBOX_DEFAULT
	giveitem ITEM_TM_SNATCH
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_RECEIVED_TM_SNATCH
	msgbox SSTidalRooms_Text_ExplainSnatch, MSGBOX_DEFAULT
	release
	end

SSTidalRooms_EventScript_ExplainSnatch::
	msgbox SSTidalRooms_Text_ExplainSnatch, MSGBOX_DEFAULT
	release
	end

SSTidalRooms_EventScript_Colton::
	trainerbattle_single TRAINER_COLTON, SSTidalRooms_Text_ColtonIntro, SSTidalRooms_Text_ColtonDefeat
	msgbox SSTidalRooms_Text_ColtonPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalRooms_EventScript_Micah::
	trainerbattle_single TRAINER_MICAH, SSTidalRooms_Text_MicahIntro, SSTidalRooms_Text_MicahDefeat
	msgbox SSTidalRooms_Text_MicahPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalRooms_EventScript_Thomas::
	trainerbattle_single TRAINER_THOMAS, SSTidalRooms_Text_ThomasIntro, SSTidalRooms_Text_ThomasDefeat
	msgbox SSTidalRooms_Text_ThomasPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalRooms_EventScript_Jed::
	trainerbattle_double TRAINER_LEA_AND_JED, SSTidalRooms_Text_JedIntro, SSTidalRooms_Text_JedDefeat, SSTidalRooms_Text_JedNotEnoughMons
	msgbox SSTidalRooms_Text_JedPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalRooms_EventScript_Lea::
	trainerbattle_double TRAINER_LEA_AND_JED, SSTidalRooms_Text_LeaIntro, SSTidalRooms_Text_LeaDefeat, SSTidalRooms_Text_LeaNotEnoughMons
	msgbox SSTidalRooms_Text_LeaPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalRooms_EventScript_Garret::
	trainerbattle_single TRAINER_GARRET, SSTidalRooms_Text_GarretIntro, SSTidalRooms_Text_GarretDefeat
	msgbox SSTidalRooms_Text_GarretPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalRooms_EventScript_Naomi::
	trainerbattle_single TRAINER_NAOMI, SSTidalRooms_Text_NaomiIntro, SSTidalRooms_Text_NaomiDefeat
	msgbox SSTidalRooms_Text_NaomiPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalRooms_Text_TakeRestOnBed:
	.string "There's a bed…\n"
	.string "Let's take a rest.$"

SSTidalRooms_Text_ColtonIntro:
	.string "I often sail to LILYCOVE CITY.\p"
	.string "I enjoy attending CONTESTS,\n"
	.string "you see.$"

SSTidalRooms_Text_ColtonDefeat:
	.string "That was an enjoyable match!$"

SSTidalRooms_Text_ColtonPostBattle:
	.string "I get so excited imagining what kinds\n"
	.string "of POKéMON I'll get to see in the next\l"
	.string "CONTEST. The anticipation of it thrills!$"

SSTidalRooms_Text_MicahIntro:
	.string "Are your friends strong?$"

SSTidalRooms_Text_MicahDefeat:
	.string "Your friends are, indeed, strong.$"

SSTidalRooms_Text_MicahPostBattle:
	.string "Friends need not be human.\n"
	.string "For me, POKéMON are treasured friends!$"

SSTidalRooms_Text_ThomasIntro:
	.string "Child…\n"
	.string "Did you knock on the door?$"

SSTidalRooms_Text_ThomasDefeat:
	.string "A loss is to be accepted without haste\n"
	.string "or panic.$"

SSTidalRooms_Text_ThomasPostBattle:
	.string "To be never ruffled in any situation is\n"
	.string "the GENTLEMAN's code of conduct.$"

SSTidalRooms_Text_JedIntro:
	.string "JED: I feel a little shy about this, but…\n"
	.string "We'll show you our lovey-dovey power!$"

SSTidalRooms_Text_JedDefeat:
	.string "JED: Sigh…$"

SSTidalRooms_Text_JedPostBattle:
	.string "JED: It's the first time that our lovey-\n"
	.string "dovey power couldn't prevail!\l"
	.string "You must be an awesome TRAINER!$"

SSTidalRooms_Text_JedNotEnoughMons:
	.string "JED: You only have one POKéMON?\n"
	.string "Isn't that just too lonesome?$"

SSTidalRooms_Text_LeaIntro:
	.string "LEA: I feel a little silly, but…\n"
	.string "We'll show you our lovey-dovey power!$"

SSTidalRooms_Text_LeaDefeat:
	.string "LEA: Oh, boo!$"

SSTidalRooms_Text_LeaPostBattle:
	.string "LEA: I can't believe it!\n"
	.string "Our lovey-dovey power failed…\l"
	.string "You must be an awesome TRAINER!$"

SSTidalRooms_Text_LeaNotEnoughMons:
	.string "LEA: I wanted to battle…\n"
	.string "But you don't even have two POKéMON…$"

SSTidalRooms_Text_GarretIntro:
	.string "Ah, you've come just in time.\p"
	.string "I'm bored, you see.\n"
	.string "You may entertain me.$"

SSTidalRooms_Text_GarretDefeat:
	.string "…That will do.$"

SSTidalRooms_Text_GarretPostBattle:
	.string "Perhaps I shall get Father to acquire\n"
	.string "a yacht for me.\l"
	.string "A yacht for me and POKéMON!$"

SSTidalRooms_Text_NaomiIntro:
	.string "Oh, you're such an adorable TRAINER.\n"
	.string "Would you like to have tea?\l"
	.string "Or would you rather battle?$"

SSTidalRooms_Text_NaomiDefeat:
	.string "I see.\n"
	.string "You're the active sort.$"

SSTidalRooms_Text_NaomiPostBattle:
	.string "A world cruise on a luxury liner has its\n"
	.string "charms, I must say…\p"
	.string "But, I will admit there is an appealing\n"
	.string "side to touring HOENN by ferry.$"

SSTidalRooms_Text_NotSuspiciousTakeThis:
	.string "Uh… Hi! I… I'm not acting suspicious!\n"
	.string "Uh… You can have this! For free!\p"
	.string "It… Honestly, I didn't SNATCH it from\n"
	.string "someone! I'd never do such a thing!\l"
	.string "It's clean! You can use it!$"

SSTidalRooms_Text_ExplainSnatch:
	.string "SNATCH steals the beneficial effects\n"
	.string "of certain moves before they can be\l"
	.string "used by a foe or ally.$"

`
