mapscripts GraniteCave_1F_MapScripts {
	
}

script GraniteCave_1F_EventScript_Hiker
{
	setspeaker("Hiker")
	msgbox("It's very dangerous to go to wild areas\nwithout Pokémon.", MSGBOX_NPC)
	closemessage
}

script GraniteCave_1F_EventScript_Trigger1
{
	setvar(VAR_TEMP_0, 1)
	goto(GraniteCave_1F_EventScript_HikerStopsYou)
}

script GraniteCave_1F_EventScript_Trigger2
{
	setvar(VAR_TEMP_0, 2)
	goto(GraniteCave_1F_EventScript_HikerStopsYou)
}

movement HikerStopsPlayerSouth
{
	emote_double_exclamation_mark
	face_down
	delay_16 * 2
	walk_fast_left * 2
	walk_fast_down
	walk_fast_right
}

movement HikerStopsPlayerNorth
{
	emote_double_exclamation_mark
	face_up
	delay_16 * 2
	walk_fast_up
	walk_fast_right
}

script(local) GraniteCave_1F_EventScript_HikerStopsYou
{
	switch(var(VAR_TEMP_0))
	{
		case 1:
			applymovement(LOCALID_GRANITE_CAVE_1F_HIKER, HikerStopsPlayerSouth)
			applymovement(LOCALID_PLAYER, moves(delay_16 * 3, delay_8, delay_1 * 4, walk_fast_right))
		case 2:
			applymovement(LOCALID_GRANITE_CAVE_1F_HIKER, HikerStopsPlayerNorth)
			applymovement(LOCALID_PLAYER, moves(delay_16 * 3, walk_fast_down))
	}
	waitmovement(LOCALID_GRANITE_CAVE_1F_HIKER)
	waitmovement(LOCALID_PLAYER)
	switch(var(VAR_TEMP_0))
	{
		case 1:
			turnobject(LOCALID_PLAYER, DIR_WEST)
			cueobject(LOCALID_GRANITE_CAVE_1F_HIKER, DIR_EAST)
		case 2:
			turnobject(LOCALID_PLAYER, DIR_NORTH)
			cueobject(LOCALID_GRANITE_CAVE_1F_HIKER, DIR_SOUTH)
	}
	setspeaker("Hiker")
	msgbox("Hey now! It's dangerous to go further\nin if you aren't a trainer.\pI can't let you continue unless you\nare.")
	closemessage
	switch(var(VAR_TEMP_0))
	{
		case 1:
			applymovement(LOCALID_GRANITE_CAVE_1F_HIKER, moves(walk_up, walk_right, face_original_direction))
		case 2:
			applymovement(LOCALID_GRANITE_CAVE_1F_HIKER, moves(walk_left, walk_down, face_original_direction))
	}
	waitmovement(LOCALID_GRANITE_CAVE_1F_HIKER)
}

raw `
GraniteCave_1F_EventScript_Hiker_Original::
	lock
	faceplayer
	goto_if_set FLAG_RECEIVED_HM_FLASH, GraniteCave_1F_EventScript_ReceivedFlash
	msgbox GraniteCave_1F_Text_GetsDarkAheadHereYouGo, MSGBOX_DEFAULT
	giveitem ITEM_HM_FLASH
	setflag FLAG_RECEIVED_HM_FLASH
	msgbox GraniteCave_1F_Text_ExplainFlash, MSGBOX_DEFAULT
	release
	end

GraniteCave_1F_EventScript_ReceivedFlash::
	msgbox GraniteCave_1F_Text_ExplainFlash, MSGBOX_DEFAULT
	release
	end

GraniteCave_1F_Text_GetsDarkAheadHereYouGo:
	.string "Hey, you.\n"
	.string "It gets awfully dark ahead.\l"
	.string "It'll be tough trying to explore.\p"
	.string "That guy who came by earlier…\n"
	.string "STEVEN, I think it was.\p"
	.string "He knew how to use FLASH, so he ought\n"
	.string "to be all right, but…\p"
	.string "Well, for us HIKERS, helping out those\n"
	.string "that we meet is our motto.\p"
	.string "Here you go, I'll pass this on to you.$"

GraniteCave_1F_Text_ExplainFlash:
	.string "Teach that hidden move FLASH to\n"
	.string "a POKéMON and use it.\p"
	.string "It lights up even the inky darkness\n"
	.string "of caves.\p"
	.string "But, to use it, you need the GYM BADGE\n"
	.string "from DEWFORD's POKéMON GYM.$"

`
