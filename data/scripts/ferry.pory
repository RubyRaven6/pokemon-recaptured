//the attendant, sailor, and ferry will always be objs 1, 2, 3 and a harbor map
const ATTENDANT = 1
const SAILOR = 2
const FERRY = 3
const PLAYER = LOCALID_PLAYER

const DEWFORD = 0
const RUSTBORO = 1
const SLATEPORT = 2
const LILYCOVE = 3
const MOSSDEEP = 4
const EVER_GRANDE = 5

script Common_EventScript_FerryAttendant
{
	lockall
	cueobjecttalking(ATTENDANT)
	setspeaker(SP_NAME_ATTENDANT)	
	msgbox("Good day! May I see your ticket?")
	waitmovement(0)

	if(var(VAR_TRACK_FERRY) != 0){dynmultipush("Dewford", 	0)}
	if(var(VAR_TRACK_FERRY) != 1){dynmultipush("Rustboro", 	1)}
	if(var(VAR_TRACK_FERRY) != 2){dynmultipush("Slateport", 	2)}
	if(var(VAR_TRACK_FERRY) != 3){dynmultipush("Lilycove", 	3)}
	if(var(VAR_TRACK_FERRY) != 4){dynmultipush("Mossdeep", 	4)}
	if(var(VAR_TRACK_FERRY) != 5){dynmultipush("Ever Grande", 5)}
	dynmultistack(0,0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
	
	msgbox("Thank you! Have a lovely trip.")
	closemessage

	applymovement(PLAYER, PlayerBoardsFerry)
	waitmovement(0)
	
	playse(SE_DOOR)
	applymovement(PLAYER, moves(walk_in_place_fast_up))
	waitse
	waitmovement(0)
	hideplayer

	setspeaker(SP_NAME_SAILOR)
	msgbox("All aboard!")
	closemessage

	playse(SE_DOOR)
	applymovement(SAILOR, moves(face_up, delay_16 * 2, walk_in_place_fast_up))
	waitse
	waitmovement(0)
	removeobject(SAILOR)

	delay (60)
	debugprint("VAR_TRACK_FERRY", VAR_TRACK_FERRY)
	switch(var(VAR_TRACK_FERRY))
	{
		case RUSTBORO:
		case MOSSDEEP:
		case EVER_GRANDE:
			applymovement (FERRY, Movement_FerryDepart_West)
			waitmovement (0)
		case DEWFORD:
		case SLATEPORT:
		case LILYCOVE:
			applymovement (FERRY, Movement_FerryDepart_East)
			waitmovement (0)
	}
	copyvar(VAR_TRACK_FERRY, VAR_RESULT)
	switch(var(VAR_TRACK_FERRY))
	{
		case DEWFORD:
			warp(MAP_DEWFORD_TOWN_HARBOR, 7, 10)
		case RUSTBORO:
			warp(MAP_RUSTBORO_CITY_HARBOR, 7, 10)
	}
	waitstate
	releaseall
	end
}

movement Movement_FerryDepart_West
{
	walk_slow_left
	walk_slow_left
	walk_slow_left
	walk_left
	walk_left
	walk_left
	walk_left
	step_end
}

movement Movement_FerryDepart_East
{
	walk_slow_right
	walk_slow_right
	walk_slow_right
	walk_right
	walk_right
	walk_right
	walk_right
	step_end
}

movement PlayerBoardsFerry
{
	walk_right * 5
	walk_up * 3
}